rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasLength(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum;
    }

    function nullableString(value, maximum) {
      return value == null || (value is string && value.size() <= maximum);
    }

    function validUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'updatedAt'])
        && nullableString(data.email, 254)
        && nullableString(data.displayName, 200)
        && data.updatedAt is timestamp;
    }

    function validProfile(data) {
      return data.keys().hasAll(['firstName', 'lastName', 'email', 'createdAt'])
        && data.keys().hasOnly(['firstName', 'lastName', 'email', 'createdAt'])
        && hasLength(data.firstName, 1, 100)
        && hasLength(data.lastName, 1, 100)
        && hasLength(data.email, 3, 254)
        && data.createdAt is timestamp;
    }

    function validTask(data, taskId) {
      return data.keys().hasAll([
          'id', 'title', 'priority', 'deadline', 'order', 'completed',
          'completedAt', 'createdAt', 'date', 'parentId'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'priority', 'deadline', 'order', 'completed',
          'completedAt', 'createdAt', 'date', 'parentId', 'recurring', 'steps'
        ])
        && data.id == taskId
        && hasLength(data.title, 1, 500)
        && data.priority in ['high', 'medium', 'low']
        && nullableString(data.deadline, 64)
        && data.order is int
        && data.order >= 0
        && data.order <= 100000
        && data.completed is bool
        && (
          (!data.completed && data.completedAt == null)
          || (data.completed && data.completedAt is timestamp)
        )
        && data.createdAt is timestamp
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('recurring' in data) || data.recurring is bool)
        && (
          !('steps' in data)
          || (data.steps is list && data.steps.size() <= 100)
        )
        && (
          data.parentId == null
          || (
            hasLength(data.parentId, 1, 128)
            && data.parentId != taskId
          )
        );
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validUser(request.resource.data);
      allow update: if isOwner(uid)
        && validUser(request.resource.data);
      allow delete: if isOwner(uid);

      match /profile/{profileId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid) && validProfile(request.resource.data);
        allow update: if isOwner(uid)
          && validProfile(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      match /tasks/{taskId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid)
          && request.query.limit != null
          && request.query.limit <= 500;
        allow create: if isOwner(uid)
          && validTask(request.resource.data, taskId);
        allow update: if isOwner(uid)
          && validTask(request.resource.data, taskId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      // Summaries and archives are generated by the Admin SDK. Clients can
      // read their own documents but cannot forge or mutate server output.
      match /summaries/{summaryId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid)
          && request.query.limit != null
          && request.query.limit <= 366;
        allow write: if false;
      }

      match /taskArchive/{taskId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid)
          && request.query.limit != null
          && request.query.limit <= 500;
        allow write: if false;
      }
    }

    // Future per-user collections remain owner-only. Known collections are
    // excluded so this fallback cannot bypass their stricter validation.
    match /users/{uid}/{collectionId}/{document=**} {
      allow get: if isOwner(uid)
        && !(collectionId in ['profile', 'tasks', 'summaries', 'taskArchive']);
      allow list: if isOwner(uid)
        && !(collectionId in ['profile', 'tasks', 'summaries', 'taskArchive'])
        && request.query.limit != null
        && request.query.limit <= 500;
      allow create, update, delete: if isOwner(uid)
        && !(collectionId in ['profile', 'tasks', 'summaries', 'taskArchive']);
    }

    // Everything outside an authenticated user's own namespace is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
